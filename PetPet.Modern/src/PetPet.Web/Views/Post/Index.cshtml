@model PetPet.Application.Social.PostFeedViewModel
@{
    ViewData["Title"] = "寵物社群牆";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h1 class="display-6 fw-bold">🐾 寵物社群牆</h1>
        <p class="text-muted">即時分享毛孩的點點滴滴，探索暖心寵物日常</p>
    </div>
    <div class="col-md-4 text-md-end mt-2 mt-md-0">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                ✏️ 發佈貼文
            </a>
        }
        else
        {
            <a asp-controller="Member" asp-action="Login" class="btn btn-outline-primary rounded-pill px-4">
                🔑 登入後發文
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    @if (!Model.Items.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="text-muted display-1 mb-3">📭</div>
            <h3>目前還沒有任何貼文</h3>
            <p class="text-muted">成為第一個在此分享毛孩點滴的飼主吧！</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-action="Create" class="btn btn-primary mt-2">立即發文</a>
            }
        </div>
    }
    else
    {
        @foreach (var item in Model.Items)
        {
            <div class="col-md-8 mx-auto mb-4">
                <div class="card shadow-sm border-0 rounded-3 h-100">
                    <div class="card-header bg-white border-bottom-0 pt-3 ps-4 pe-4 d-flex align-items-center">
                        <a href="/Members/@item.AuthorPublicId" class="text-decoration-none d-flex align-items-center text-dark">
                            <div class="rounded-circle bg-light d-flex justify-content-center align-items-center text-secondary fw-bold me-2 overflow-hidden border" style="width: 44px; height: 44px;">
                                @if (!string.IsNullOrEmpty(item.AuthorPhoto))
                                {
                                    <img src="@item.AuthorPhoto" class="w-100 h-100 object-fit-cover" alt="@item.AuthorName">
                                }
                                else
                                {
                                    <span>@(item.AuthorName.Length > 0 ? item.AuthorName.Substring(0, 1) : "?")</span>
                                }
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">@item.AuthorName</h6>
                                <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</small>
                            </div>
                        </a>
                    </div>
                    <div class="card-body p-0">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <a asp-action="Details" asp-route-id="@item.Id">
                                <img src="@item.ImageUrl" class="w-100 object-fit-cover" style="max-height: 380px;" alt="@item.Title">
                            </a>
                        }
                        <div class="p-4">
                            <h5 class="card-title fw-bold">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                    @item.Title
                                </a>
                            </h5>
                            <p class="card-text text-secondary" style="white-space: pre-line;">@item.Snippet</p>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0 pb-3 ps-4 pe-4 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-action="SetLike" method="post" class="d-inline">
                                    <input type="hidden" name="postId" value="@item.Id" />
                                    <input type="hidden" name="desiredLiked" value="@(!item.ViewerHasLiked ? "true" : "false")" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit" class="btn btn-sm rounded-pill @(item.ViewerHasLiked ? "btn-danger" : "btn-outline-danger")">
                                        @(item.ViewerHasLiked ? "❤️" : "🤍") 喜歡 (@item.LikeCount)
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-light text-secondary border p-2">❤️ @item.LikeCount</span>
                            }

                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-pill">
                                💬 留言 (@item.CommentCount)
                            </a>
                        </div>
                        <div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-primary text-decoration-none small fw-bold">
                                查看全文 ➜
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <div class="col-12 d-flex justify-content-center my-4">
                <nav aria-label="貼文分頁">
                    <ul class="pagination">
                        <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">上一頁</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">第 @Model.CurrentPage 頁 / 共 @Model.TotalPages 頁 (總計 @Model.TotalItems 則)</span>
                        </li>
                        <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">下一頁</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>
