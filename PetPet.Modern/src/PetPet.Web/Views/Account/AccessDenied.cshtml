@{
    ViewData["Title"] = "存取權限不足";
}

<div class="container py-5 text-center">
    <div class="glass-card p-5 mx-auto" style="max-width: 600px;">
        <div class="display-1 text-warning mb-3">⛔</div>
        <h2 class="text-white fw-bold mb-3">存取權限不足 (403 Forbidden)</h2>
        <p class="text-white-50 mb-4">
            抱歉，您目前的帳號沒有權限存取此頁面。此功能僅限特定管理身分操作。
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a href="/" class="btn btn-outline-light rounded-pill px-4">返回首頁</a>
            <a href="/Member/Login" class="btn btn-primary rounded-pill px-4">以其他帳號登入</a>
        </div>
    </div>
</div>
