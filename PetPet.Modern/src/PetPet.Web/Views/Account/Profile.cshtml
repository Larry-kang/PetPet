@model PetPet.Application.Members.EditProfileDto
@{
    ViewData["Title"] = "個人檔案設定";
    var cities = ViewBag.Cities as List<PetPet.Domain.Entities.City> ?? [];
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h3 class="fw-bold mb-1">⚙️ 個人檔案設定</h3>
                    <p class="text-muted mb-0">更新您的稱呼、居住縣市與玩伴推薦狀態</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Profile" method="post">
                        <input type="hidden" asp-for="Version" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">暱稱 / 姓名</label>
                            <input asp-for="Name" class="form-control rounded-3" required maxlength="40" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CityId" class="form-label fw-bold">所在縣市</label>
                            <select asp-for="CityId" class="form-select rounded-3">
                                <option value="">(尚未設定)</option>
                                @foreach (var city in cities)
                                {
                                    <option value="@city.Id">@city.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CityId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Bio" class="form-label fw-bold">個人簡介</label>
                            <textarea asp-for="Bio" class="form-control rounded-3" rows="4" maxlength="500" placeholder="分享您的養寵經歷或生活日常..."></textarea>
                            <span asp-validation-for="Bio" class="text-danger small"></span>
                        </div>

                        <!-- Preset Avatar Picker -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">頭像照片 (選擇預設圖庫)</label>
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="row g-2 mb-2">
                                    <div class="col-3 text-center">
                                        <div class="border rounded p-2 bg-white cursor-pointer" onclick="selectPreset('/images/presets/avatar-boy.svg')">
                                            <img src="/images/presets/avatar-boy.svg" class="img-fluid" style="height: 60px;" alt="男孩">
                                            <div class="small text-muted mt-1">男孩</div>
                                        </div>
                                    </div>
                                    <div class="col-3 text-center">
                                        <div class="border rounded p-2 bg-white cursor-pointer" onclick="selectPreset('/images/presets/avatar-girl.svg')">
                                            <img src="/images/presets/avatar-girl.svg" class="img-fluid" style="height: 60px;" alt="女孩">
                                            <div class="small text-muted mt-1">女孩</div>
                                        </div>
                                    </div>
                                    <div class="col-3 text-center">
                                        <div class="border rounded p-2 bg-white cursor-pointer" onclick="selectPreset('/images/presets/avatar-dog.svg')">
                                            <img src="/images/presets/avatar-dog.svg" class="img-fluid" style="height: 60px;" alt="狗狗">
                                            <div class="small text-muted mt-1">狗狗</div>
                                        </div>
                                    </div>
                                    <div class="col-3 text-center">
                                        <div class="border rounded p-2 bg-white cursor-pointer" onclick="selectPreset('/images/presets/avatar-cat.svg')">
                                            <img src="/images/presets/avatar-cat.svg" class="img-fluid" style="height: 60px;" alt="貓咪">
                                            <div class="small text-muted mt-1">貓咪</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="input-group">
                                    <input asp-for="Photo" id="inputPhoto" class="form-control" placeholder="已選頭像路徑" readonly />
                                    <button type="button" class="btn btn-outline-secondary" onclick="clearPreset()">清除頭像</button>
                                </div>
                            </div>
                        </div>

                        <!-- Match Switch -->
                        <div class="card p-3 bg-light border-0 mb-4">
                            <div class="form-check form-switch fs-5">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="IsMatchEnabled" id="matchSwitch">
                                <label class="form-check-label fw-bold fs-6" for="matchSwitch">
                                    開啟「玩伴推薦」功能
                                </label>
                            </div>
                            <small class="text-muted mt-1">
                                開啟後，您的毛孩將出現在玩伴推薦名單中，同時您也可以在配對專區探索契合的毛孩好朋友。
                            </small>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="ChangePassword" class="btn btn-outline-secondary rounded-pill">
                                🔒 修改密碼
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5">儲存個人設定</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function selectPreset(path) {
            document.getElementById('inputPhoto').value = path;
        }
        function clearPreset() {
            document.getElementById('inputPhoto').value = '';
        }
    </script>
}
