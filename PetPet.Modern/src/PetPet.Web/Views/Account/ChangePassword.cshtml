@model PetPet.Application.Members.ChangePasswordDto
@{
    ViewData["Title"] = "修改密碼";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4 text-center">
                    <h3 class="fw-bold mb-1">🔒 修改登入密碼</h3>
                    <p class="text-muted mb-0">變更密碼後將自動撤銷目前的登入憑證，需重新以新密碼登入</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-bold">目前密碼</label>
                            <input asp-for="CurrentPassword" class="form-control rounded-3" type="password" required />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-bold">新密碼 (8–128 字元)</label>
                            <input asp-for="NewPassword" class="form-control rounded-3" type="password" required />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold">再次確認新密碼</label>
                            <input asp-for="ConfirmPassword" class="form-control rounded-3" type="password" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill btn-lg">確認修改並重新登入</button>
                            <a asp-action="Profile" class="btn btn-light rounded-pill">取消返回</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
