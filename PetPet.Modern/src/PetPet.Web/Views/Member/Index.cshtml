@{
    ViewData["Title"] = "會員列表";
}

<div class="container mt-5 text-center">
    <div class="card shadow-sm border-0 rounded-4 p-5">
        <h2 class="fw-bold mb-3">👥 會員專區</h2>
        <p class="text-muted mb-4">公開會員名片與寵物資訊，請透過社群動態牆或玩伴推薦探索。</p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Post" asp-action="Index" class="btn btn-primary rounded-pill px-4">前往社群動態</a>
            <a asp-controller="Match" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">探索玩伴推薦</a>
        </div>
    </div>
</div>
