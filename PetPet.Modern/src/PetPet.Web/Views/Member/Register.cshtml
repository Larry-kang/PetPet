@model PetPet.Application.Members.RegisterMember
@{
    ViewData["Title"] = "註冊會員";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card glass-card">
                <div class="card-header bg-transparent border-bottom-0 pt-4 text-center">
                    <h3 class="card-title mb-0 fw-bold text-primary">📝 註冊會員</h3>
                </div>
                <div class="card-body px-5 pb-5">
                    <form asp-action="Register">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email (帳號)</label>
                            <input asp-for="Email" class="form-control" type="email" required />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">密碼</label>
                            <input asp-for="Password" class="form-control" type="password" required />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">姓名</label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">電話</label>
                            <input asp-for="Phone" class="form-control" required />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <!-- Photo Picker -->
                        <div class="mb-4 text-center">
                            <label class="form-label d-block text-start">個人頭像</label>
                            <div class="d-flex align-items-center gap-3">
                                <img id="previewPhoto" src="/images/default-user.png" class="rounded-circle border border-2 border-white shadow-sm object-fit-cover" width="80" height="80">
                                <div>
                                    <input type="hidden" name="Photo" id="inputPhoto" />
                                    <button type="button" class="btn btn-outline-light btn-sm" onclick="openImagePicker('inputPhoto', 'previewPhoto')">
                                        📷 選擇照片
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">立即註冊</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">返回列表</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <partial name="_ImagePicker" />
}
